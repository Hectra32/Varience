#include "node.h"
#include "draw.h"
#include "fetch.h"
#include "object.h"
#include "path.h"

int rn_gid = 1;
int node_id = 1;

void add_node(Gate_Ins *obj) {
  obj->group.node_count = obj->gate->input + obj->gate->output;

  obj->group.node = malloc(sizeof(*obj->group.node) * obj->group.node_count);

  if (obj->group.node == NULL) {
    obj->group.node_count = 0;
    return;
  }

  for (size_t i = 0; i < obj->group.node_count; i++) {
    obj->group.node[i].node_id = node_id++;
    obj->group.node[i].igid = rn_gid++;
    obj->group.node[i].signal = 0;
    obj->group.node[i].x = 0;
    obj->group.node[i].y = 0;
    obj->group.node[i].is_selected = 0;

    obj->group.node[i].type = (i < obj->gate->input) ? Input : Output;
  }
}

void update_node(Game *game, Gate_Ins *obj) {
  if (!game->mouse_left_one_f)
    return;

  for (size_t i = 0; i < obj->group.node_count; i++) {
    Node *node = &obj->group.node[i];

    int dx = game->mouse_x - node->x;
    int dy = game->mouse_y - node->y;

    if (dx * dx + dy * dy <= 6 * 6) {

      // No node selected yet
      if (game->selected_node == NULL) {
        node->is_selected = 1;
        game->selected_node = node;
        return;
      }

      // Clicked the same node
      if (game->selected_node == node) {
        node->is_selected = 0;
        game->selected_node = NULL;
        return;
      }

      // Second node -> create wire
      if (game->wire_count < MAX_WIRES) {
        game->wires[game->wire_count].from = game->selected_node;

        game->wires[game->wire_count].to = node;

        game->wire_count++;
      }

      // Clear selection
      game->selected_node->is_selected = 0;
      node->is_selected = 0;
      game->selected_node = NULL;

      return;
    }
  }
}

// Made it more readable and fixed it making select node 1 and 4 and --
// everytime

void draw_node(Game *game) {
  for (int i = 0; i < local_num; i++) {
    Gate_Ins *obj = gate_ins[i];

    if (obj == NULL || obj->gate == NULL)
      continue;

    int input_node = obj->gate->input;
    int output_node = obj->gate->output;
    int r = 6;

    int inp[input_node];
    int otp[output_node];

    if (input_node > 0)
      divide_gap(obj->gate->height, input_node, inp);

    if (output_node > 0)
      divide_gap(obj->gate->height, output_node, otp);

    for (int in = 0; in < input_node; in++) {
      Node *node = &obj->group.node[in];

      node->x = obj->x;
      node->y = obj->y + inp[in];

      if (node->is_selected)
        SDL_SetRenderDrawColor(game->renderer, 25, 255, 255, 255);
      else
        SDL_SetRenderDrawColor(game->renderer, 255, 255, 255, 255);

      DrawFilledCircle(game->renderer, node->x, node->y, r);
    }

    for (int ot = 0; ot < output_node; ot++) {
      Node *node = &obj->group.node[input_node + ot];

      node->x = obj->x + obj->gate->width;
      node->y = obj->y + otp[ot];

      if (node->is_selected)
        SDL_SetRenderDrawColor(game->renderer, 25, 255, 255, 255);
      else
        SDL_SetRenderDrawColor(game->renderer, 255, 255, 255, 255);

      DrawFilledCircle(game->renderer, node->x, node->y, r);
    }
  }
}
